{
  "name": "md-to-zhihu",
  "version": "1.0.0",
  "description": "这是从Zhihu Obsidian中拆分出来的一个库，这里分为了full和lite模式。lite模式下不会依赖Obsidian、cookies、typst命令行、Mermaid等，只有纯粹markdown转换。所以使用lite模式时需要先将图片转换为知乎图床URL，再进行转换。",
  "main": "index.js",
  "scripts": {
    "build": "esbuild modes/lite.ts --bundle --format=esm --platform=neutral --main-fields=module,main --target=es2020 --outfile=dist/lite.mjs --log-level=info --define:process.env.NODE_ENV=\\\"production\\\" --define:process.env=\\\"{}\\\"",
    "test": "qjs lite.test.mjs"
  },
  "keywords": ["zhihu","markdown","html","ast"],
  "author": "dgg",
  "license": "ISC",
  "type": "commonjs"
}
